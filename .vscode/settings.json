{
  // Use Prettier as the default formatter for JSON and JSONC files
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // File associations for embedded development
  "files.associations": {
    "*.h": "c",
    "*.c": "c",
    "*.s": "arm",
    "*.ld": "linkerscript",
    "stm32f4xx.h": "c",
    "stm32f429xx.h": "c"
  },

  // Clang-Format settings (clang-format is taken from PATH; set
  // "clang-format.executable" in your *user* settings if it is elsewhere)
  "[cpp]": {
    "editor.defaultFormatter": "xaver.clang-format"
  },
  "[c]": {
    "editor.defaultFormatter": "xaver.clang-format"
  },

  // CMake configuration: everything comes from CMakePresets.json
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": true,

  // Editor settings for C development
  "editor.rulers": [80, 120],
  "editor.renderWhitespace": "all",
  "editor.detectIndentation": false,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,

  // C/C++ IntelliSense: use the compile commands of the active CMake preset
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "C_Cpp.default.cStandard": "gnu11",
  "C_Cpp.enhancedColorization": "enabled",
  "C_Cpp.suggestSnippets": true,

  // Cortex-Debug: arm-none-eabi-gdb and openocd are taken from PATH. If they
  // are not on PATH set "cortex-debug.armToolchainPath" and
  // "cortex-debug.openocdPath" in your *user* settings (machine specific).
  "cortex-debug.variableUseNaturalFormat": false,
  "terminal.integrated.stickyScroll.enabled": false
}
