{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "STM32F429 Debug (ST-Link)",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/debug/STM32_F429ZI_Template.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "device": "STM32F429ZI",
      "interface": "swd",
      "runToEntryPoint": "main",
      "preLaunchTask": "STM32 Build (Debug)",
      // Optional: path to STM32F429.svd for the peripheral view, e.g. from the
      // STM32CubeF4 package; set the STM32_SVD_DIR environment variable
      "svdFile": "${env:STM32_SVD_DIR}/STM32F429.svd",
      "configFiles": ["interface/stlink.cfg", "target/stm32f4x.cfg"],
      "showDevDebugOutput": "parsed"
    }
  ]
}
